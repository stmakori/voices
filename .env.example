# Copy this file to .env and fill in real values. Never commit .env.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=

# Database (leave unset to use local SQLite)
DATABASE_URL=

# AWS Cognito (authentication)
AWS_COGNITO_USER_POOL_ID=
AWS_COGNITO_APP_CLIENT_ID=
AWS_COGNITO_APP_CLIENT_SECRET=
AWS_COGNITO_REGION=eu-north-1

# Groq / AI assistant ("Amani")
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GBV_AI_MODEL=llama-3.3-70b-versatile

# Resource geocoding default
RESOURCE_DEFAULT_COUNTY=Nakuru County

# Email (defaults to console backend for local dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@voicesagainstviolence.ke

# Production hardening (leave unset for local dev; defaults follow DEBUG)
SESSION_COOKIE_SECURE=
CSRF_COOKIE_SECURE=
SECURE_SSL_REDIRECT=
SECURE_HSTS_SECONDS=
SECURE_HSTS_INCLUDE_SUBDOMAINS=
SECURE_HSTS_PRELOAD=
